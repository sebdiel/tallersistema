# Servidor web de producción.
# Caddy obtiene y renueva solo el certificado HTTPS (Let's Encrypt) para {$DOMAIN}.
# Con DOMAIN=localhost usa un certificado local (pruebas).
{
	email {$ACME_EMAIL:admin@example.com}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	# API NestJS (misma dirección que la app: sin problemas de CORS).
	handle /api/* {
		reverse_proxy backend:3000
	}

	# PWA Angular
	handle {
		root * /srv

		# Estos archivos deciden si hay versión nueva de la app: nunca en caché.
		@sin_cache path / /index.html /ngsw.json /ngsw-worker.js /manifest.webmanifest
		header @sin_cache Cache-Control "no-cache"

		# JS y CSS llevan un hash en el nombre: se pueden guardar un año.
		@con_hash path_regexp \.[0-9A-Z]{8}\.(js|css)$
		header @con_hash Cache-Control "public, max-age=31536000, immutable"

		# Rutas de la SPA (/ordenes/123) → index.html
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
