# Configuración de PRODUCCIÓN (copiar a .env.prod y completar). Nunca subir .env.prod a GitHub.

# Dominio apuntando a la IP del VPS (registro DNS tipo A). Caddy saca el HTTPS solo.
DOMAIN=taller.midominio.com
# Correo para avisos de Let's Encrypt (vencimiento de certificados).
ACME_EMAIL=tu-correo@ejemplo.com

# Contraseña de PostgreSQL. Generar con: openssl rand -base64 24
POSTGRES_PASSWORD=cambiar-por-una-contraseña-larga

# Secreto de los tokens de sesión. Generar con: openssl rand -hex 32
JWT_SECRET=cambiar-por-64-caracteres-aleatorios
JWT_EXPIRES_IN=12h

# SUPERADMIN inicial (solo se crea si la base está vacía). Cambie la contraseña tras el primer ingreso.
SEED_SUPERADMIN_EMAIL=superadmin@midominio.com
SEED_SUPERADMIN_PASSWORD=cambiar-esta-contraseña

# Precio mensual de la suscripción (Bs), usado en el panel global.
PRECIO_SUSCRIPCION=90

# Días que se conservan los respaldos diarios.
BACKUP_RETENCION_DIAS=14

# Puertos públicos (dejar 80/443 en el VPS).
HTTP_PORT=80
HTTPS_PORT=443
